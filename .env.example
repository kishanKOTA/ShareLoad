# Copy to repo-root .env; never commit .env or a real key.
GEMINI_API_KEY=
# Blank uses gemini-flash-latest. Pin a model for a reproducible demo.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=30000
# Comma-separated explicit frontend origins; no wildcard or trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Relative paths resolve from the repository root.
SHARELOAD_DATA_DIR=data/demo
SHARELOAD_DATABASE_PATH=services/api/shareload.db
# Phase 2: demo reset is opt-in and forbidden under production.
SHARELOAD_ENV=development
SHARELOAD_DEMO_MODE=false
SHARELOAD_USE_GEMINI=true
# Writable engine cache; source data/demo is never written by the API.
SHARELOAD_RUNTIME_DIR=services/api/runtime
